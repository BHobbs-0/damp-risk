# Data (licensed / large) - keep folder structure only
data/**
!data/**/
!data/**/.gitkeep

# Observable Framework dashboard (the loader cache in dashboard/src/.observablehq/cache IS committed:
# small, aggregated JSON that lets the site build without the raw data)
dashboard/node_modules/
dashboard/dist/
dashboard/src/.observablehq/cache/*
!dashboard/src/.observablehq/cache/data/

# Python
__pycache__/
*.py[cod]
.venv/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

# Editors / OS
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# Secrets
.env
